{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipward tracker file (.shipward/tracker.json)",
  "type": "object",
  "required": [
    "version",
    "projects",
    "cards",
    "feed"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "activeProject": {
      "type": "string",
      "description": "Project id the UI shows by default"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "prefix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "slug, e.g. 'brewnote'"
          },
          "name": {
            "type": "string"
          },
          "tag": {
            "type": "string",
            "description": "one-line descriptor"
          },
          "prefix": {
            "type": "string",
            "description": "card id prefix, e.g. 'BW'"
          },
          "checks": {
            "type": "object",
            "description": "Named checks done() may run, declared by a HUMAN (SW-043). No MCP tool writes this map. Each value is an argv array run without a shell, so a check cannot carry a payload.",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "checkTimeoutMs": {
            "type": "integer",
            "minimum": 1,
            "description": "how long a check may run before it counts as absence of evidence; default 120000"
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "p",
          "title",
          "type",
          "pri",
          "effort",
          "status",
          "created"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$",
            "description": "PREFIX-NNN, zero-padded, never reused"
          },
          "p": {
            "type": "string",
            "description": "project id this card belongs to"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "feature",
              "bug",
              "chore"
            ]
          },
          "pri": {
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "effort": {
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "status": {
            "enum": [
              "backlog",
              "claude",
              "review",
              "pushed",
              "shipped"
            ],
            "description": "shipped = archived"
          },
          "claude": {
            "enum": [
              "queued",
              "working",
              "done",
              null
            ],
            "description": "Claude Code's own state while status='claude'"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "git branch, e.g. feat/brew-timer"
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "description": "short sha of the latest relevant commit"
          },
          "note": {
            "description": "Since SW-039 note entries are STORED in .shipward/notes.jsonl, not here — a written tracker carries no note text at all. This field remains valid because the store hydrates it on every read (so every consumer still sees card.note) and because hand-editing a note straight into the tracker is still supported: the next write moves it to the sidecar.",
            "oneOf": [
              {
                "type": "string",
                "description": "legacy prose; segments separated by ' || '"
              },
              {
                "type": "array",
                "description": "structured entries, append-only in spirit (SW-028)",
                "items": {
                  "type": "object",
                  "required": [
                    "t",
                    "text"
                  ],
                  "properties": {
                    "t": {
                      "type": "string",
                      "format": "date-time",
                      "description": "when this entry was written"
                    },
                    "kind": {
                      "enum": [
                        "open",
                        "finding",
                        "decision",
                        "evidence",
                        "outcome",
                        "brief"
                      ],
                      "description": "stated kind; omitted = classified from the text"
                    },
                    "text": {
                      "type": "string"
                    },
                    "resolves": {
                      "type": "string",
                      "pattern": "^[A-Z]+-[0-9]{3}$",
                      "description": "card id whose open items this entry settles"
                    },
                    "sha": {
                      "type": "string",
                      "description": "the commit this entry was true of (SW-044). Evidence without one cannot be expired — it can only be dated."
                    },
                    "dirty": {
                      "type": "boolean",
                      "description": "the tree carried uncommitted changes, so this entry is not reproducible from its sha"
                    }
                  }
                }
              }
            ],
            "description": "context / decisions; Claude Code appends here. String prose or an array of dated entries."
          },
          "check": {
            "type": [
              "string",
              "null"
            ],
            "description": "NAME of a check declared in this card's project. A name nothing declares is unverified, never executed (SW-043)."
          },
          "verification": {
            "type": [
              "object",
              "null"
            ],
            "description": "What the last check proved, and about which tree (SW-043). Absence means nothing was ever run.",
            "required": [
              "check",
              "exit",
              "ok",
              "at",
              "sha"
            ],
            "properties": {
              "check": {
                "type": "string",
                "description": "the name that was resolved"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exit": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "null when the check timed out or could not be spawned"
              },
              "ok": {
                "type": "boolean"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "sha": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "HEAD when the check ran — what SW-044 reads to expire this evidence"
              },
              "dirty": {
                "type": "boolean",
                "description": "true if the tree carried uncommitted changes; a pass nobody else can reproduce"
              },
              "ms": {
                "type": "integer"
              },
              "timedOut": {
                "type": "boolean"
              }
            }
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "pushed": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "shipped": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "feed": {
      "type": "array",
      "description": "Newest first, cap at 200 entries",
      "items": {
        "type": "object",
        "required": [
          "t",
          "p",
          "msg"
        ],
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "p": {
            "type": "string",
            "description": "project id"
          },
          "msg": {
            "type": "string",
            "description": "one human-readable line, e.g. 'Claude Code pushed 3f8c21a \u2014 BW-014 moved to Review'"
          },
          "by": {
            "enum": [
              "claude",
              "user"
            ],
            "description": "who wrote the entry"
          }
        }
      }
    }
  }
}
