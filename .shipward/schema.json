{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipward tracker file (.shipward/tracker.json)",
  "type": "object",
  "required": [
    "version",
    "projects",
    "cards",
    "feed"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "activeProject": {
      "type": "string",
      "description": "Project id the UI shows by default"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "prefix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "slug, e.g. 'brewnote'"
          },
          "name": {
            "type": "string"
          },
          "tag": {
            "type": "string",
            "description": "one-line descriptor"
          },
          "prefix": {
            "type": "string",
            "description": "card id prefix, e.g. 'BW'"
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "p",
          "title",
          "type",
          "pri",
          "effort",
          "status",
          "created"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$",
            "description": "PREFIX-NNN, zero-padded, never reused"
          },
          "p": {
            "type": "string",
            "description": "project id this card belongs to"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "feature",
              "bug",
              "chore"
            ]
          },
          "pri": {
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "effort": {
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "status": {
            "enum": [
              "backlog",
              "claude",
              "review",
              "pushed",
              "shipped"
            ],
            "description": "shipped = archived"
          },
          "claude": {
            "enum": [
              "queued",
              "working",
              "done",
              null
            ],
            "description": "Claude Code's own state while status='claude'"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "git branch, e.g. feat/brew-timer"
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "description": "short sha of the latest relevant commit"
          },
          "note": {
            "oneOf": [
              {
                "type": "string",
                "description": "legacy prose; segments separated by ' || '"
              },
              {
                "type": "array",
                "description": "structured entries, append-only in spirit (SW-028)",
                "items": {
                  "type": "object",
                  "required": [
                    "t",
                    "text"
                  ],
                  "properties": {
                    "t": {
                      "type": "string",
                      "format": "date-time",
                      "description": "when this entry was written"
                    },
                    "kind": {
                      "enum": [
                        "open",
                        "finding",
                        "decision",
                        "evidence",
                        "outcome",
                        "brief"
                      ],
                      "description": "stated kind; omitted = classified from the text"
                    },
                    "text": {
                      "type": "string"
                    },
                    "resolves": {
                      "type": "string",
                      "pattern": "^[A-Z]+-[0-9]{3}$",
                      "description": "card id whose open items this entry settles"
                    }
                  }
                }
              }
            ],
            "description": "context / decisions; Claude Code appends here. String prose or an array of dated entries."
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "pushed": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "shipped": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "feed": {
      "type": "array",
      "description": "Newest first, cap at 200 entries",
      "items": {
        "type": "object",
        "required": [
          "t",
          "p",
          "msg"
        ],
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "p": {
            "type": "string",
            "description": "project id"
          },
          "msg": {
            "type": "string",
            "description": "one human-readable line, e.g. 'Claude Code pushed 3f8c21a \u2014 BW-014 moved to Review'"
          },
          "by": {
            "enum": [
              "claude",
              "user"
            ],
            "description": "who wrote the entry"
          }
        }
      }
    }
  }
}
